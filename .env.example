# ============================================================================
# AI 聚合网关 · 生产环境配置模板（CentOS 7.9 + 宝塔 + PHP 8.2 + MySQL 8）
# ----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   # 然后逐项填写下面的「必须改」项
#
# ⚠️ 本文件是**模板**，不要直接当 .env 用。
# ⚠️ 真正的 .env 里含数据库口令与加密主密钥，务必：
#     chmod 600 .env
#     chown www:www .env
# ============================================================================

# ---------------------------------------------------------------------------
# 应用基础
# ---------------------------------------------------------------------------
AIGW_APP_NAME=AI 聚合网关

# 【必须改】生产环境必须为 false。
#   为 true 时异常处理会把堆栈/文件路径吐给客户端，等于把内部结构送人。
AIGW_APP_DEBUG=false

# 【必须改】改成你的实际访问地址（带协议，不要结尾斜杠）。
#   用途：生成对外接入地址、OAuth 回调地址、CORS 同源判定。
#   若用 IP 访问就写 http://123.45.67.89
AIGW_APP_URL=http://your-domain.com

# 【必须改】凭据加密主密钥（AES-256-GCM）。
#   生成方式（在服务器上执行）：
#     php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#   ⚠️ 一旦开始录入账号凭据就**绝不能再改** —— 改了旧凭据全部解不开。
#   ⚠️ 不要把这一行原样留着上线，必须替换成上面命令生成的真实值。
AIGW_APP_KEY=base64:请用上面的命令生成后替换掉这一整行

# ---------------------------------------------------------------------------
# 管理台登录入口（可选，隐藏默认入口降低被扫描爆破概率）
# ---------------------------------------------------------------------------
# 默认为 /api/admin/login。若想隐藏，改成某个不易猜到的路径，例如：
# AIGW_ADMIN_LOGIN_PATH=/api/admin/x-9f3k-login
# ⚠️ 改完必须重启 PHP，且前端请求路径也要同步（本项目前端读接口下发值，通常无需手改 JS）。

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
AIGW_DB_HOST=127.0.0.1
AIGW_DB_PORT=3306
# 【必须改】在 MySQL 中创建（或已存在）的库名
AIGW_DB_DATABASE=aigw
# 【必须改】专用数据库账号（不要用 root）
AIGW_DB_USERNAME=aigw
# 【必须改】数据库口令（不要用 123456 之类的弱口令）
AIGW_DB_PASSWORD=请填写你为数据库账号设置的口令

# ---------------------------------------------------------------------------
# 网关对外地址
# ---------------------------------------------------------------------------
# 仅用于展示「接入地址」，实际对外由 nginx 承载。保持与 AIGW_APP_URL 一致即可。
AIGW_GATEWAY_PORT=51120
AIGW_GATEWAY_BASE_URL=http://your-domain.com

# ---------------------------------------------------------------------------
# 跨域白名单（可选）
# ---------------------------------------------------------------------------
# 同源（AIGW_APP_URL）始终允许，无需在此重复。
# 只有当你要从**别的域名**的前端页面调用本网关接口时才需要填，多个用逗号分隔。
# 例：AIGW_CORS_ORIGINS=https://panel.other.com,http://localhost:5173
AIGW_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 可信反向代理（重要：同时决定「客户端真实 IP」与「SSRF 白名单」）
# ---------------------------------------------------------------------------
# 语义：只有**直连来源**是这个列表里的 IP 时，才会采信它带来的 X-Forwarded-For。
#   · 127.0.0.1 / ::1 始终可信（本机 nginx 转发时即为这种）
#   · 若你在前面还挂了 CDN / 负载均衡，把回源 IP 段填在这里
#
# ⚠️ 两种典型场景：
#   场景一（推荐，最常见）：nginx 与 PHP 同机，nginx 用 127.0.0.1 连 PHP-FPM
#       → 保持为空即可，客户端 IP 由 127.0.0.1 可信、XFF 取真实 IP，全部正常。
#   场景二：站点跑在 Docker / 独立 PHP 机器上，PHP 看到的是内网 IP
#       → 必须把 nginx 的内网 IP 填进来，否则所有日志里的客户端 IP 都会是内网 IP，
#         基于 IP 的限流也会失效。
#
# 🔴 场景三（本站线上就是这样）：前面挂了**腾讯云 EdgeOne（EO）CDN**
#       → EO 的回源 IP 段接口**已下线**（2026-07-31 停更 / 08-31 关停），
#         拿不到段清单 → `set_real_ip_from <EO 段>` 那套**不可用**。
#       → 本站改用 **「回源令牌」**（零 IP 段依赖，见本文件末尾 AIGW_ORIGIN_TOKEN 一节）。
#         回源令牌方案下，本项 `AIGW_TRUSTED_PROXIES` **可以保持为空**。
#       → 仍然必须确认 EO 控制台的「真实客户端 IP 回源」开关：**没开的话**，
#         回源请求里不会有 `EO-Connecting-IP` 头，真实 IP 依然拿不到。
#       → 本项匹配是**精确 IP 比较**（不做 CIDR 展开）；回源令牌方案不依赖本项。
AIGW_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# 回源令牌（★ 站点走 CDN 时的「客户端真实 IP」方案，零 IP 段依赖）
# ---------------------------------------------------------------------------
# 背景：EdgeOne 回源 IP 段接口已下线，无法用 set_real_ip_from 还原真实 IP。
#       「回源令牌」用**一个只有你和 CDN 知道的密钥**替代「信任某个 IP 段」：
#         · CDN 控制台：给**回源请求**加一个自定义请求头，值 = 这个密钥；
#         · nginx：不带（或带错）该头的请求直接 403 —— 挡掉绕过 CDN 直连源站的扫描；
#         · PHP：只在令牌正确的请求里采信客户端 IP 头（EO 为 EO-Connecting-IP）。
#       攻击者不知道密钥 → 伪造的头一律不被采信 → 退回直连 IP，限流不失效。
#
# ⚠️ 三个值必须**成套**配置，缺一不可；只配一个会静默退化成「所有人共用一个桶」。
#
# 1) 生成密钥（64 位十六进制，别用弱口令）：
#      openssl rand -hex 32
# 2) 填到这里（同一份值也要填进 CDN 控制台的回源请求头）：
# AIGW_ORIGIN_TOKEN=
# 3) 口令所在的头名（须与 CDN 控制台配置的一致；小写，连字符）：
#      建议自定一个不常见的名字，别用 X-Forwarded-For 这类会被客户端顺带提交的头。
# AIGW_ORIGIN_TOKEN_HEADER=x-aigw-origin-token
# 4) 真实客户端 IP 所在的头名（EdgeOne 固定为 eo-connecting-ip，腾讯云 CDN 为 x-forwarded-for）
# AIGW_CLIENT_IP_HEADER=eo-connecting-ip

# ---------------------------------------------------------------------------
# 允许访问内网上游（默认关闭，安全相关）
# ---------------------------------------------------------------------------
# 仅当你需要接入「部署在同一内网的自建上游」时才打开。
# 打开后 URL 守卫会放行 10/8、172.16/12、192.168/16 等私网地址 ——
# 这会削弱 SSRF 防护（自定义供应商的 base_url 是用户可控字段）。
# 除非确实需要，否则保持注释状态。
# AIGW_ALLOW_PRIVATE_UPSTREAM=0

# ---------------------------------------------------------------------------
# 验证码求解运行时（仅「ZCode 领额度」功能需要，可留空）
# ---------------------------------------------------------------------------
# ★ Node 可执行文件绝对路径。留空则按「版本从高到低择优」自动探测。
#   **必须 ≥ 20.10 或 ≥ 21（推荐 22）** —— 求解器依赖全局 WebSocket，
#   而它自 v21.0.0 / v20.10.0 才加入；Node 18 与宝塔默认的 v16 都没有。
#   ★★ CentOS 7 特别注意：官方 Node 18+ 用 glibc 2.28 编译，而 CentOS 7 是 2.17，
#      直接装会报 `GLIBC_2.28 not found`。必须用 glibc-217 专用构建：
#        https://unofficial-builds.nodejs.org/download/release/  (文件名含 -glibc-217)
#        国内镜像：https://registry.npmmirror.com/-/binary/node-unofficial-builds/
#      **切勿升级系统 glibc**（会让 ssh/yum 一起崩）。详见 docs/deployment.md §8.1
#   自查判据（不是看版本号）：/usr/local/nodejs/bin/node -e "console.log(process.version, typeof WebSocket)"
#   要输出末尾 function；报 GLIBC not found 就说明拿错包了。
# AIGW_NODE_BIN=/usr/local/nodejs/bin/node

# ★ 浏览器绝对路径。留空则按 chrome/chromium/headless_shell 顺序探测。
#   CentOS 7 只能装 ≤ 125 的 Chrome（126+ 要 GLIBC_2.25，127+ 还会触发
#   yum 的 "Invalid version flag: or"，详见 docs/deployment.md §8.2）。
#   生产环境务必显式指定，避免 PATH 变化导致探测失败。
# AIGW_BROWSER_BIN=/usr/bin/google-chrome-stable

# ── 显示模式（2026-10-02 新增，解决 F001「疑似攻击请求」）────────────────────
# 🔴 阿里云验证码 2.0 的风控**会识别无头浏览器指纹**，直接判
#    F001「疑似攻击请求，风险策略不通过」→ 领额度报「自动过验证码失败」。
#    求解器已默认改跑**有头**浏览器（有头实测 3~4s 稳过，比无头还快）。
#    Linux 服务器无物理显示，需 Xvfb 提供虚拟屏：
#
#      yum install -y xorg-x11-server-Xvfb
#
#    然后二选一（推荐①）：
#      ① 常驻虚拟屏（最稳，无起停开销）：
#           nohup Xvfb :99 -screen 0 1920x1080x24 >/dev/null 2>&1 &
#         开机自启可写 systemd，然后在此处填：
#     ② 不配也行 —— 装上 Xvfb 后脚本会自动用 xvfb-run 临起临关（每次多 ~1s）
#
# AIGW_XVFB_DISPLAY=:99

# 强制指定有头/无头。1=无头（**会被风控拦，仅调试用**），0=有头。留空=自动。
# AIGW_CAPTCHA_HEADLESS=0

# ---------------------------------------------------------------------------
# Antigravity（Google OAuth）客户端凭据
# ---------------------------------------------------------------------------
# 使用 Antigravity 供应商时**必须**填写（仓库不内置任何默认凭据）。
# 在 Google Cloud Console 创建 OAuth 客户端后，把 ID 与密钥填到这里。
AIGW_ANTIGRAVITY_CLIENT_ID=
AIGW_ANTIGRAVITY_CLIENT_SECRET=
